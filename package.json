{
  "name": "mpd3",
  "version": "1.1.1",
  "description": "Low level MPD (Music Player Daemon) client with Web Streams API",
  "main": "./dist/index.cjs",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "prokosna",
  "contributors": [
    "Cotko <cotkocot@gmail.com>",
    "Andrew Kelley <superjoe30@gmail.com>"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "lint": "biome check ./lib ./__tests__",
    "lint:fix": "biome check ./lib ./__tests__ --write",
    "test": "vitest run",
    "test:unit": "vitest run unit",
    "test:int": "vitest run int",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prokosna/mpd.js"
  },
  "keywords": [
    "mpd",
    "mpd2",
    "mpd3",
    "music",
    "player",
    "daemon",
    "client",
    "protocol"
  ],
  "dependencies": {
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
